# ═══════════════════════════════════════════════════════════════════════════
# PRODUCTION environment — copy to ".env.prod" on the server and fill in.
#   cp .env.prod.example .env.prod   &&   nano .env.prod
# NEVER commit .env.prod. It is read by docker-compose.prod.yml.
# ═══════════════════════════════════════════════════════════════════════════

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_APP=wsgi.py
FLASK_ENV=production
LOG_LEVEL=INFO
# Generate a strong one:  openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
# Leave FALSE for the initial HTTP deploy; set to true AFTER HTTPS is live,
# otherwise the session cookie won't be sent over plain http and logins break.
SESSION_COOKIE_SECURE=false

# ── Database (the "db" service) ────────────────────────────────────────────
POSTGRES_USER=marine
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD
POSTGRES_DB=marine_exam
# Host is the compose service name "db"; must match the three values above.
DATABASE_URL=postgresql+psycopg2://marine:REPLACE_WITH_A_STRONG_DB_PASSWORD@db:5432/marine_exam

# ── Object storage — MinIO ("minio" service) ───────────────────────────────
# Host is the internal service name; browsers never hit this directly.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=marine-sketches
STORAGE_ACCESS_KEY=REPLACE_WITH_A_STRONG_MINIO_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_A_STRONG_MINIO_SECRET
# (To use DigitalOcean Spaces instead of MinIO: drop the "minio" service, set
#  STORAGE_ENDPOINT=https://<region>.digitaloceanspaces.com, STORAGE_REGION=<region>,
#  and the Spaces access/secret keys. No code change.)

# ── Email (approval notifications) — optional ──────────────────────────────
# Fill either the SMTP_* group or SENDGRID_API_KEY. If blank, emails are logged
# instead of sent (the app still works).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
ADMIN_NOTIFY_EMAIL=you@example.com
# MAIL_FROM must be a sender you've verified in Brevo, or messages won't deliver.
MAIL_FROM=no-reply@your-domain.com
# Public site URL used to build password-reset links in emails.
# Use plain http until HTTPS is live, then switch to https (and flip
# SESSION_COOKIE_SECURE=true above at the same time).
APP_BASE_URL=https://engineroomacademy.org

# ── gunicorn ───────────────────────────────────────────────────────────────
# Rule of thumb: (2 x CPU cores) + 1.
GUNICORN_WORKERS=3

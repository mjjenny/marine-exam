# ── Flask ────────────────────────────────────────────────
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# ── Database ─────────────────────────────────────────────
# Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgresql+psycopg2://marine:marine@localhost:5432/marine_exam

# ── Object storage (DigitalOcean Spaces / local MinIO) ───
# Local dev = MinIO (start with: docker compose --profile storage up -d minio).
# Production = DigitalOcean Spaces: set STORAGE_ENDPOINT=https://blr1.digitaloceanspaces.com,
# STORAGE_REGION=blr1, and the Spaces access/secret keys. No code changes needed.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=marine-sketches
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ── Email (approval notifications) ───────────────────────
# Use either SMTP_* or SENDGRID_API_KEY.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
ADMIN_NOTIFY_EMAIL=cl76380@gmail.com
MAIL_FROM=no-reply@marine-exam.local
